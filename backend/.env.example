# Criminal Network Analysis System - Environment Configuration
# Copy this to .env and fill in your values

# FastAPI Settings
DEBUG=True
APP_NAME=Criminal Network Analysis API
APP_VERSION=0.1.0

# Groq LLM Configuration (for future NLP enhancement)
# Get your API key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Data Paths (relative to project root)
DATA_DIR=./synthetic_data
FIR_FOLDER=./synthetic_data/FIRs
CDR_FILE=./synthetic_data/call_detail_records.csv
TRANSACTION_FILE=./synthetic_data/financial_transactions.csv
METADATA_FILE=./synthetic_data/metadata.json

# Processing Configuration
MAX_UPLOAD_SIZE=104857600
EXTRACTION_BATCH_SIZE=10
ENTITY_SIMILARITY_THRESHOLD=0.88

# Neo4j Configuration (for future implementation)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Server
HOST=0.0.0.0
PORT=8000
